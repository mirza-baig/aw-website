# Git LFS Hook
command -v git-lfs >/dev/null 2>&1 || { echo >&2 "\nThis repository is configured for Git LFS but 'git-lfs' was not found on your path. If you no longer wish to use Git LFS, remove this hook by deleting '.git/hooks/post-merge'.\n"; exit 2; }
git lfs post-merge "$@"

# Our Checks
echo "Running post-merge 🔗"

# Call out changes to packages and give user notification
npx git-pull-run --pattern "package-lock.json" --message "Some packages were changed. You may run npm install to update your dependencies..."
npx git-pull-run --pattern "pnpm-lock.yaml" --message "Some packages were changed. You may run pnpm install to update your dependencies..."
